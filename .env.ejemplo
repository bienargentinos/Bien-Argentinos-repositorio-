# PLANTILLA DEL .env — SOLO LOS NOMBRES, NUNCA LOS VALORES
#
# Este archivo SÍ va a GitHub. El `.env` de verdad NO va nunca: está en .gitignore y tiene que
# quedarse así.
#
# Para qué sirve: si mañana hay que levantar Marcos en un servidor nuevo, esta es la lista de todo
# lo que hace falta. Sin ella, la única copia del inventario está en la cabeza de alguien.
#
#   cp .env.ejemplo .env     y completar los valores
#   node revisar-env.js      dice qué falta, sin mostrar ningún valor
#
# ── QUÉ SE PUEDE RECUPERAR Y QUÉ NO ─────────────────────────────────────────────────────────
#
# Casi todo se regenera. Lo único verdaderamente molesto de perder es el token de Meta, porque hay
# que volver a pasar por el panel de WhatsApp Business y reconfigurar el webhook.
#
#   🔴 difícil   WHATSAPP_ACCESS_TOKEN
#   🟡 rehacer   GEMINI_API_KEY, ELEVENLABS_API_KEY, el JSON de Google (se bajan de nuevo)
#   🟢 fácil     el resto: los elegís vos, o están a la vista en la URL de la planilla

# ── WHATSAPP (Meta Cloud API) ───────────────────────────────────────────────────────────────
# El token es el dato más caro de perder de todo el archivo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que Meta manda al verificar el webhook. Lo elegís vos, tiene que coincidir con el panel.
VERIFY_TOKEN=

# ── IA ──────────────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Voz. Sin esto Marcos contesta igual, solo que siempre por texto.
ELEVENLABS_API_KEY=
TTS_MAX_AUDIOS_24H=2

# ── GOOGLE SHEETS ───────────────────────────────────────────────────────────────────────────
# El ID está a la vista en la URL de la planilla: /spreadsheets/d/ESTO_DE_ACA/edit
GOOGLE_SHEET_ID=
# NOMBRE del archivo JSON de credenciales, que va al lado de index.js. No es su contenido.
GOOGLE_CREDENTIALS_FILE=

# ── BASE DE DATOS ───────────────────────────────────────────────────────────────────────────
# La contraseña de PostgreSQL se puede cambiar cuando quieras: la base es local.
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/marcos_db
SQLITE_DB_PATH=marcos_database.sqlite
# Poner en 0 para que el motor lea de Sheets y no de PostgreSQL (útil para diagnosticar).
LECTURA_PG=1

# ── PANEL ───────────────────────────────────────────────────────────────────────────────────
DASHBOARD_USER=
DASHBOARD_PASS=
# Clave con la que se firman las sesiones. Cualquier texto largo y al azar sirve.
DASHBOARD_SECRET=
# Compatibilidad: los clientes nuevos van a la pestaña `clientes` de Sheets, no acá.
CONSORCIO_USERS=

# ── AVISOS A LA ADMINISTRACIÓN ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PHONE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── SERVIDOR ────────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ_AR=America/Argentina/Buenos_Aires
# Portal del vecino: 1 lo habilita.
PORTAL_VECINO=1

# ── PESTAÑAS DE SHEETS (opcionales) ─────────────────────────────────────────────────────────
# Solo hace falta ponerlas si alguna pestaña se llama distinto de lo que el código espera.
# SHEET_TAB_EVENTOS=
# SHEET_TAB_EDIFICIOS=
# SHEET_TAB_CLIENTES=
# SHEET_TAB_PROVEEDORES=
# SHEET_TAB_ASIGNACIONES=
# SHEET_TAB_EXPENSAS=
# SHEET_TAB_ARCHIVOS=
